version: '3.8'

services:
  # ===== DATABASES =====
  
  postgres-user:
    image: postgres:15-alpine
    container_name: agritrace-user-db
    environment:
      POSTGRES_DB: user_db
      POSTGRES_USER: agritrace
      POSTGRES_PASSWORD: agritrace2026
    ports:
      - "5433:5432"
    volumes:
      - user-db-data:/var/lib/postgresql/data
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U agritrace"]
      interval: 10s
      timeout: 5s
      retries: 5

  postgres-product:
    image: postgres:15-alpine
    container_name: agritrace-product-db
    environment:
      POSTGRES_DB: product_db
      POSTGRES_USER: agritrace
      POSTGRES_PASSWORD: agritrace2026
    ports:
      - "5434:5432"
    volumes:
      - product-db-data:/var/lib/postgresql/data
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U agritrace"]
      interval: 10s
      timeout: 5s
      retries: 5

  postgres-trace:
    image: postgres:15-alpine
    container_name: agritrace-trace-db
    environment:
      POSTGRES_DB: trace_db
      POSTGRES_USER: agritrace
      POSTGRES_PASSWORD: agritrace2026
    ports:
      - "5435:5432"
    volumes:
      - trace-db-data:/var/lib/postgresql/data
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U agritrace"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ===== CACHE & MESSAGING =====

  redis:
    image: redis:7-alpine
    container_name: agritrace-redis
    ports:
      - "6379:6379"
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  zookeeper:
    image: confluentinc/cp-zookeeper:7.5.0
    container_name: agritrace-zookeeper
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    networks:
      - agritrace-network

  kafka:
    image: confluentinc/cp-kafka:7.5.0
    container_name: agritrace-kafka
    depends_on:
      - zookeeper
    ports:
      - "9092:9092"
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: 'true'
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD", "kafka-broker-api-versions", "--bootstrap-server", "localhost:9092"]
      interval: 30s
      timeout: 10s
      retries: 3

  # ===== MICROSERVICES =====

  user-service:
    build:
      context: .
      dockerfile: user-service/Dockerfile
    container_name: agritrace-user-service
    depends_on:
      postgres-user:
        condition: service_started
      redis:
        condition: service_started
    environment:
      SPRING_PROFILES_ACTIVE: docker
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres-user:5432/user_db
      SPRING_DATASOURCE_USERNAME: agritrace
      SPRING_DATASOURCE_PASSWORD: agritrace2026
      SPRING_REDIS_HOST: redis
      SPRING_REDIS_PORT: 6379
      GRPC_SERVER_PORT: 9090
      JWT_SECRET: ${JWT_SECRET:-agritrace-super-secret-key-2026-must-be-at-least-256-bits}
    ports:
      - "8081:8080"
      - "9091:9090"
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8080/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  product-service:
    build:
      context: .
      dockerfile: product-service/Dockerfile
    container_name: agritrace-product-service
    depends_on:
      postgres-product:
        condition: service_started
      user-service:
        condition: service_started
      kafka:
        condition: service_started
    environment:
      SPRING_PROFILES_ACTIVE: docker
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres-product:5432/product_db
      SPRING_DATASOURCE_USERNAME: agritrace
      SPRING_DATASOURCE_PASSWORD: agritrace2026
      GRPC_SERVER_PORT: 9090
      GRPC_CLIENT_USER_ADDRESS: static://user-service:9090
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
    ports:
      - "8082:8080"
      - "9092:9090"
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8080/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  trace-service:
    build:
      context: .
      dockerfile: trace-service/Dockerfile
    container_name: agritrace-trace-service
    depends_on:
      postgres-trace:
        condition: service_started
      product-service:
        condition: service_started
      kafka:
        condition: service_started
    environment:
      SPRING_PROFILES_ACTIVE: docker
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres-trace:5432/trace_db
      SPRING_DATASOURCE_USERNAME: agritrace
      SPRING_DATASOURCE_PASSWORD: agritrace2026
      GRPC_SERVER_PORT: 9090
      GRPC_CLIENT_PRODUCT_ADDRESS: static://product-service:9090
      GRPC_CLIENT_USER_ADDRESS: static://user-service:9090
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
    ports:
      - "8083:8080"
      - "9093:9090"
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8080/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  media-service:
    build:
      context: .
      dockerfile: media-service/Dockerfile
    container_name: agritrace-media-service
    depends_on:
      - product-service
    environment:
      SPRING_PROFILES_ACTIVE: docker
      GRPC_CLIENT_PRODUCT_ADDRESS: static://product-service:9090
    ports:
      - "8084:8080"
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8080/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  api-gateway:
    build:
      context: .
      dockerfile: api-gateway/Dockerfile
    container_name: agritrace-api-gateway
    depends_on:
      user-service:
        condition: service_started
      product-service:
        condition: service_started
      trace-service:
        condition: service_started
      media-service:
        condition: service_started
    environment:
      SPRING_PROFILES_ACTIVE: docker
      JWT_SECRET: ${JWT_SECRET:-agritrace-super-secret-key-2026-must-be-at-least-256-bits}
      SERVICE_USER_URL: http://user-service:8080
      SERVICE_PRODUCT_URL: http://product-service:8080
      SERVICE_TRACE_URL: http://trace-service:8080
      SERVICE_MEDIA_URL: http://media-service:8080
    ports:
      - "8080:8080"
    networks:
      - agritrace-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8080/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

networks:
  agritrace-network:
    driver: bridge

volumes:
  user-db-data:
  product-db-data:
  trace-db-data:

