# ============================================================
# AgriTrace – Environment Variables Example
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in all values (especially generate new secrets!)
#   3. NEVER commit .env to version control
#
# Security Tip: Generate strong secrets with:
#   openssl rand -base64 48
# ============================================================

# ===== JWT Configuration =====
# MUST be at least 256 bits (32 bytes). Use a random, unpredictable string.
# Generate: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_at_least_32_bytes_long

# Access token lifetime in milliseconds (default: 15 minutes = 900000)
JWT_ACCESS_TOKEN_EXPIRATION=900000

# Refresh token lifetime in milliseconds (default: 7 days = 604800000)
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ===== Database Passwords =====
# Change these in production! Never use default passwords.
POSTGRES_USER=agritrace
POSTGRES_PASSWORD=your_secure_postgres_password

# ===== Grafana Admin Credentials =====
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_admin_password

# ===== Redis Configuration =====
# If Redis requires authentication in production:
REDIS_PASSWORD=

# ===== Tracing Configuration =====
# 1.0 = 100% sampling (for dev/demo). Use 0.1 or lower in high-traffic production.
TRACING_SAMPLING_PROBABILITY=1.0

# Zipkin endpoint
ZIPKIN_URL=http://zipkin:9411

# ===== Logging =====
# DEBUG, INFO, WARN, ERROR
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO

# ===== Service URLs (Docker internal) =====
EUREKA_URL=http://eureka-server:8761/eureka/

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ===== Nginx / Frontend =====
# Public domain for HTTPS cert (leave empty for self-signed dev cert)
NGINX_DOMAIN=localhost

# ===== Feature Flags =====
# Enable/disable anomaly detection alerts
ANOMALY_DETECTION_ENABLED=true
# GPS anomaly threshold in km (log outside this radius triggers alert)
ANOMALY_GPS_RADIUS_KM=5.0
